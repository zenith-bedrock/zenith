<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\raknet\raknet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\data\block_palette.nbt">
      <LogicalName>block_palette.nbt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\data\creative_items.json">
      <LogicalName>creative_items.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\data\item_palette.json">
      <LogicalName>item_palette.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
