<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Precompile on publish (a RID-specific publish, which is what release and the images do); build and run stay on the JIT.
         Measured with the cold-start scenario of the runtime-load harness (see the .NET opportunities doc): first tick 108-124 ms -> 55-63 ms, methods JIT-compiled while the loop runs
         1510 -> 561 (docs/dotnet-opportunities.md, item 2). -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\raknet\raknet.csproj" />
    <ProjectReference Include="..\nethernet\nethernet.csproj" />
    <ProjectReference Include="../../libs/binary/binary.csproj" />
    <ProjectReference Include="../../libs/logging/logging.csproj" />
    <ProjectReference Include="..\..\libs\nbt\nbt.csproj" />
    <ProjectReference Include="..\..\libs\leveldb\leveldb.csproj" />
    <ProjectReference Include="..\..\libs\diagnostics\diagnostics.csproj" />
    <ProjectReference Include="..\zenith.PacketGenerator\zenith.PacketGenerator.csproj"
                       OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="data\manifest.json">
      <LogicalName>bedrock_data_manifest.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\block_palette.nbt">
      <LogicalName>block_palette.nbt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\creative_items.json">
      <LogicalName>creative_items.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\item_palette.json">
      <LogicalName>item_palette.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\biome_definitions.bin">
      <LogicalName>biome_definitions.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\item_durability.json">
      <LogicalName>item_durability.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\join_static.json">
      <LogicalName>join_static.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\join_static\*.bin">
      <LogicalName>join_static/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\mobs.json">
      <LogicalName>mobs.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\spawns.json">
      <LogicalName>spawns.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\recipes.json.gz">
      <LogicalName>recipes.json.gz</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="data\jigsaw_structures_data.nbt">
      <LogicalName>jigsaw_structures_data.nbt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.0.2-alpha</Version>
    <InformationalVersion>0.0.2-alpha</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="zenith.Tests" />
    <InternalsVisibleTo Include="zenith.Benchmarks" />
  </ItemGroup>

</Project>
